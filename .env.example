# ============================================================
# RydeResolve-Agent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- LLM Configuration ---
# Primary: Tencent Hunyuan (OpenAI-compatible endpoint)
# Fallback: Any OpenAI-compatible API (e.g. OpenAI, Deepseek, etc.)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# --- Tencent Cloud Credentials (for Hunyuan, VectorDB, etc.) ---
TENCENT_SECRET_ID=your_secret_id_here
TENCENT_SECRET_KEY=your_secret_key_here
TENCENT_REGION=ap-singapore

# --- Hunyuan LLM (if using Tencent directly) ---
HUNYUAN_API_URL=your_hunyuan_api_url
HUNYUAN_MODEL=hunyuan-pro

# --- Vector Database (ChromaDB) ---
# When running with docker-compose, use "chromadb" as host
# When running locally, use "localhost"
CHROMA_HOST=localhost
CHROMA_PORT=8200
CHROMA_COLLECTION=ryde_policies

# --- Tencent VectorDB (optional, if not using ChromaDB) ---
VECTORDB_API_URL=your_vectordb_url
VECTORDB_COLLECTION=ryde_policies

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ryde_resolve

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Agent Settings ---
MAX_DEBATE_ROUNDS=3
CONFIDENCE_THRESHOLD_HIGH=0.8
CONFIDENCE_THRESHOLD_LOW=0.5

# --- API Settings ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Supported Languages (Singapore Official Languages) ---
SUPPORTED_LANGUAGES=en,zh,ms,ta
