# ============================================================
# RydeResolve-Agent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# --- FREE TIER: Tencent Hunyuan ---
# Tencent Cloud International: https://www.tencentcloud.com/products/hunyuan
# Activate free tier: https://console.tencentcloud.com/hunyuan/start
# Get API Key: https://console.tencentcloud.com/cam/capi
# Free: 1,000,000 tokens per model (1 year expiry)
# Models: hunyuan-turbos-latest (chat), hunyuan-embedding (vectors)
# ============================================================

# --- LLM Configuration ---
# Tencent Hunyuan — OpenAI-compatible endpoint (FREE 1M tokens)
# International: Get key at https://console.tencentcloud.com/cam/capi
LLM_API_KEY=your_hunyuan_api_key_here
LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
LLM_MODEL=hunyuan-turbos-latest
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# --- Hunyuan Embedding ---
HUNYUAN_EMBEDDING_MODEL=hunyuan-embedding

# --- Tencent Cloud Credentials (optional, for native SDK calls) ---
# International: Get key at https://console.tencentcloud.com/cam/capi
# Only needed for Tencent VectorDB or other non-OpenAI-compatible APIs
TENCENT_SECRET_ID=your_secret_id_here
TENCENT_SECRET_KEY=your_secret_key_here
TENCENT_REGION=ap-singapore

# --- Vector Database (ChromaDB) ---
# When running with docker-compose, use "chromadb" as host
# When running locally, use "localhost"
CHROMA_HOST=localhost
CHROMA_PORT=8200
CHROMA_COLLECTION=ryde_policies

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ryde_resolve

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Agent Settings ---
MAX_DEBATE_ROUNDS=3
CONFIDENCE_THRESHOLD_HIGH=0.8
CONFIDENCE_THRESHOLD_LOW=0.5

# --- API Settings ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Supported Languages (Singapore Official Languages) ---
SUPPORTED_LANGUAGES=en,zh,ms,ta
